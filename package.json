{
  "name": "@xiaoxing/persona-manager",
  "version": "0.2.0-rc.3",
  "private": true,
  "description": "Manage XiaoxingBot persona and user-profile files and apply them as same-named DSH Agent presets.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "keywords": ["dsh", "deepseek-harness", "persona", "agent-preset", "xiaoxing"],
  "scripts": {
    "check": "node --check index.js && node --check client.js && node scripts/check-package.mjs",
    "test": "node tests/run.mjs"
  },
  "author": {
    "name": "xiaoxing-nya",
    "email": "xiaoxing_bot@luoli.my"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "defaults",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "docs",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
